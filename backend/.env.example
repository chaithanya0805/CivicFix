# Database configuration (MySQL)
DB_NAME=civicfix
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Django Security settings
SECRET_KEY=django-insecure-change-this-in-production-123456
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# SimpleJWT configuration
JWT_SECRET=jwt-secret-change-this-in-production-123456

# AI provider configuration (options: mock, gemini)
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Email notifications (SMTP Settings)
# Set EMAIL_ENABLED=True to trigger real emails, otherwise django will print to console
EMAIL_ENABLED=False
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_password
EMAIL_FROM=CivicFix Alerts <noreply@civicfix.org>
